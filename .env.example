# BentaHub Environment Variables
# Copy this file to `.env.local` for local development.
# For Vercel: set these in the dashboard (Settings → Environment Variables).
# NOTE: NEXT_PUBLIC_* values are baked into the build — set them before `next build`.

# Database Configuration (required in ALL environments)
# Local: postgresql://postgres:password@localhost:5432/bentahub
# Neon: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/bentahub?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/bentahub"

# JWT Configuration (required in production; the placeholder below is REJECTED in prod)
# Generate a strong random value, e.g. `openssl rand -base64 32`
JWT_SECRET="your-secret-key-change-in-production"

# Email Configuration (Leave blank for automatic Mailpit or Ethereal fallback)
EMAIL_SERVICE=""
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="noreply@bentahub.local"
EMAIL_HOST="localhost"
EMAIL_PORT="1025"

# App Configuration
NODE_ENV="development"
# Production: must be your deployed domain, e.g. https://bentahub.vercel.app
# Used for OAuth redirects, password-reset links, and payment return URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PayMongo (GCash payments)
# Get your keys from https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY="pk_test_xxx"
# Webhook URL to configure in PayMongo: https://<your-domain>/api/webhooks/paymongo
# Enable webhook signing and paste the secret here.
PAYMONGO_WEBHOOK_SECRET="whsec_xxx"

# Receipt print server (optional)
# Runs on a Windows PC at the store: `pnpm print-server` (port 3001).
# Leave EMPTY on Vercel → the app falls back to saving the receipt as a PDF.
# When a store PC exists: NEXT_PUBLIC_PRINT_SERVER_URL="http://<pc-ip>:3001"
NEXT_PUBLIC_PRINT_SERVER_URL=""

# Optional: Third-party services
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLIC_KEY=""
# GCASH_API_KEY=""

# Social sign-in (Google OAuth 2.0 + Facebook Login)
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:3000/api/auth/oauth/google/callback
#   Production: https://<your-domain>/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
#
# Facebook: https://developers.facebook.com/apps (add the "Facebook Login" product)
# Valid OAuth redirect URI: http://localhost:3000/api/auth/oauth/facebook/callback
#   Production: https://<your-domain>/api/auth/oauth/facebook/callback
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""

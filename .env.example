# BentaHub Environment Variables
# Copy this file to `.env.local` for local development.
# For Vercel: set these in the dashboard (Settings → Environment Variables).
# NOTE: NEXT_PUBLIC_* values are baked into the build — set them before `next build`.

# Database Configuration (required in ALL environments)
# Local: postgresql://postgres:password@localhost:5432/bentahub
# Neon: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/bentahub?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/bentahub"

# JWT Configuration (required in production; the placeholder below is REJECTED in prod)
# Generate a strong random value, e.g. `openssl rand -base64 32`
JWT_SECRET="your-secret-key-change-in-production"

# MFA encryption key (required in production; rejected if missing/placeholder)
# Used to encrypt TOTP secrets at rest. Generate with:
#   openssl rand -base64 32
MFA_ENC_KEY="change-this-to-a-random-32-byte-string-for-mfa-encryption"

# Email Configuration (Leave blank for automatic Mailpit or Ethereal fallback)
EMAIL_SERVICE=""
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="noreply@bentahub.local"
EMAIL_HOST="localhost"
EMAIL_PORT="1025"

# App Configuration
NODE_ENV="development"
# Production: must be your deployed domain, e.g. https://bentahub.vercel.app
# Used for OAuth redirects, password-reset links, and payment return URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PayMongo (GCash payments)
# Get your keys from https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY="pk_test_xxx"
# Webhook URL to configure in PayMongo: https://<your-domain>/api/webhooks/paymongo
# Enable webhook signing and paste the secret here.
PAYMONGO_WEBHOOK_SECRET="whsec_xxx"

# Receipt printing
# 1st choice: Web Bluetooth prints straight to the thermal printer (PT-210 /
# GOOJPRT) from Chrome/Edge — real 58mm ESC/POS bytes, works on PC and Android.
# 2nd choice: the Windows print server below. It AUTO-PICKs an installed
# thermal printer (PT-210/GOOJPRT/thermal), else uses the default printer, and
# adapts layout (32 cols thermal / 42 cols inkjet). Runs via `pnpm print-server`
# or `server/start-print-server.bat`.
#   Cashier PC (localhost): NEXT_PUBLIC_PRINT_SERVER_URL="http://localhost:3001"
#   Android/iOS through the store PC: "http://<store-pc-lan-ip>:3001"
# If both are unavailable, the receipt is saved as a PDF.
# Optional: force a specific Windows printer (instead of auto-detect):
#   PRINTER_NAME="GOOJPRT PT-210"
NEXT_PUBLIC_PRINT_SERVER_URL="http://localhost:3001"

# PT-210 (GOOJPRT) over USB — NO driver install needed:
#   The print server talks straight to the USB printer-class interface that
#   Windows already exposes (usbprint.sys), so receipts print as raw ESC/POS
#   without a printer queue or third-party driver.
#   1. Plug in the PT-210 and power it ON.
#   2. Start the print server: `node server/print-server.cjs` (or the .bat).
#   3. Check `http://localhost:3001/status` → `"usb": true`.
#   Auto-start: pin `server/start-print-server.bat` into shell:startup
#   (Win+R, type shell:startup, drop a shortcut there).
# Transport strategy (default auto):
#   auto  = direct USB, then print queue, then plain text
#   usb   = direct USB only (no queue fallback)
#   queue = Windows print queue only (requires an installed printer driver)
# PRINT_TRANSPORT="auto"
# USB vendor:product of the POS printer used for the direct USB path:
# USB_PRINTER_VID_PID="0FE6:811E"

# Optional: Third-party services
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLIC_KEY=""
# GCASH_API_KEY=""

# Social sign-in (Google OAuth 2.0 + Facebook Login)
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:3000/api/auth/oauth/google/callback
#   Production: https://<your-domain>/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
#
# Facebook: https://developers.facebook.com/apps (add the "Facebook Login" product)
# Valid OAuth redirect URI: http://localhost:3000/api/auth/oauth/facebook/callback
#   Production: https://<your-domain>/api/auth/oauth/facebook/callback
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""
